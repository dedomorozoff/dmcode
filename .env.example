# Первый запуск без ключей запустит визард — он сам запишет сюда провайдера.
# Бесплатные варианты:
#   OpenCode Zen — https://opencode.ai/auth           (free-модели: nemotron, mimo, big-pickle)
#   Groq       — https://console.groq.com/keys      (быстрый, tool calling, щедрый free tier)
#   OpenRouter — https://openrouter.ai/keys         (deepseek :free и др.)
#   Mistral    — https://console.mistral.ai/api-keys (Codestral)

# OpenCode Zen:
# OPENCODE_API_KEY=...
# OPENAI_BASE_URL=https://opencode.ai/zen/v1
# DMCODE_MODEL=nemotron-3-ultra-free

# Ручная настройка (любой OpenAI-совместимый endpoint):
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_...
# DMCODE_MODEL=qwen/qwen3-32b
